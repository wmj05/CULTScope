# 复制本文件为 backend/.env 后填入真实值（.env 已被 .gitignore 忽略）

# ---------- 应用 ----------
APP_NAME=CULTScope
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# ---------- TMDb API ----------
# 在 https://www.themoviedb.org/settings/api 申请「API Read Access Token」
# 只填 Token 本身，不要加 "Bearer " 前缀
TMDB_BEARER_TOKEN=
TMDB_API_BASE=https://api.themoviedb.org/3
TMDB_LANGUAGE=zh-CN

# ---------- MySQL ----------
# 阶段一暂不连接数据库，阶段二启用
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cultscope
